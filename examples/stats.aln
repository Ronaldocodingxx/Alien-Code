# small statistics library with inline tests: alien test examples/stats.aln

pub fn mean(xs) if len(xs) == 0 { nil } else { sum(xs) / len(xs) }

pub fn median(xs) {
  if len(xs) == 0 { ret nil }
  s := sort(xs)
  mid := len(s) // 2
  if len(s) % 2 == 1 { s[mid] } else { (s[mid - 1] + s[mid]) / 2 }
}

pub fn stdev(xs) {
  m := mean(xs)
  if m == nil { ret nil }
  sqrt(sum(xs, fn(x) (x - m) ** 2) / len(xs))
}

pub fn summary(xs) {n: len(xs), mean: mean(xs), median: median(xs), min: min(xs), max: max(xs)}

test "mean" {
  assert(mean([1, 2, 3, 4]) == 2.5)
  assert(mean([]) == nil)
}

test "median" {
  assert(median([3, 1, 2]) == 2)
  assert(median([4, 1, 3, 2]) == 2.5)
}

test "stdev" {
  assert(stdev([2, 4, 4, 4, 5, 5, 7, 9]) == 2)
}

test "summary" {
  assert(summary([5, 1, 3]) == {n: 3, mean: 3, median: 3, min: 1, max: 5})
}
