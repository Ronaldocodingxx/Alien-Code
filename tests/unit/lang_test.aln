fn add(a, b = 10) a + b

test "defaults and calls" {
  assert(add(1, 2) == 3)
  assert(add(1) == 11)
}

test "closures keep state" {
  fn counter() {
    n := 0
    fn() { n += 1; n }
  }
  c := counter()
  c()
  assert(c() == 2)
}

test "async inside tests" {
  await sleep(1)
  assert(true)
}

test "round digits and sort desc" {
  assert(round(3.14159, 2) == 3.14)
  assert(round(2.5) == 3)
  assert(sort([1, 3, 2], nil, true) == [3, 2, 1])
  assert(sort([{n: 1}, {n: 2}], fn(o) o.n, true) == [{n: 2}, {n: 1}])
}
