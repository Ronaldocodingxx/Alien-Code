# line continuation: leading . |> && || ?? continue the previous line
s := "  Hello  "
  .trim()
  .toLowerCase()
print(s)
ok := true
  && 1 < 2
print(ok)
# object literal as fn body or match arm (with or without parens)
mk := fn(x) ({v: x})
mk2 := fn(x) {v: x, w: 2}
mk3 := fn(x) {x, ...{y: 1}}
fn blk(x) { x }
print(mk(1), mk2(1), mk3(1), blk(5), match 1 { _ => {hit: true} })
# JS reserved words are fine as names
class := "c"; default := 2
print(class, default)
# underscore params
print(map([1, 2], fn(_, i) i))
# match inside loop with break/continue
found := nil
for x in [1, 2, 3, 4] {
  match x {
    1 => continue
    3 => { found = x; break }
    _ => print("saw {x}")
  }
}
print(found)
# match as value, nested data patterns, rest
fn sumlist(xs) match xs {
  [] => 0
  [h, ...t] => h + sumlist(t)
}
print(sumlist([1, 2, 3]))
kind := match {type: "circle", r: 2} {
  {type: "circle", r} => 3 * r * r
  {type: "rect", w, h} => w * h
}
print(kind)
print(match 2 { 1 | 2 | 3 => "small", _ => "big" })
# if without else is nil
print(if false { 1 })
# early return from a loop
fn firstEven(xs) {
  for x in xs { if x % 2 == 0 { ret x } }
  nil
}
print(firstEven([1, 3, 4, 5]), firstEven([1]))
# multiline calls and lists
r := join(
  [
    "a",
    "b",
  ],
  "|",
)
print(r)
# unicode + escapes in interpolated strings
who := "Wörld 🌍"
print("tab\there {who}\n2nd")
# recursion through a lambda binding
fact := fn(n) if n <= 1 { 1 } else { n * fact(n - 1) }
print(fact(10))
# try as statement with rethrow message
try { json("not json") } catch e { print("bad json") }
# assignment from if
y := 0
y = if y == 0 { "zero" } else { "other" }
print(y)
# compound assignment on fields and indexes
o := {n: 1, xs: [1, 2]}
o.n += 4
o.xs[0] *= 10
print(o)
