use "alien:web" {serve, h, css, page, client, reply, redirect}

STYLE := css({".x": {color: "red"}}, {".a, .b": {"&:focus": {color: "blue"}}})
server := serve({
  "/": fn(req) page({title: "Home", css: STYLE, body: [h.h1("Hi"), h.json("data", {name: "</script>"}), client("{here}/web/app.aln")]}),
  "/api/user/:id": fn(req) {id: req.params.id, q: req.query.q},
  "POST /api/echo": fn(req) req.body,
  "POST /login": fn(req) redirect("/", {cookies: {sid: "abc 123", theme: {value: "dark", maxAge: 60, httpOnly: false}}}),
  "/me": fn(req) req.cookies,
  "/logout": fn(req) reply(200, "bye", {cookies: {sid: nil}}),
  "/old": fn(req) redirect("/", {status: 301}),
  "/teapot": fn(req) reply(418, "short and stout", "text/plain"),
  "/async": fn(req) { await sleep(1); "done" },
  "/files/*": fn(req) req.params["*"],
  "*": fn(req) reply(404, page({title: "404", body: h.h1("Nicht gefunden: {req.path}")})),
}, {port: 0, quiet: true})
await new Promise(fn(ok) server.once("listening", ok))
base := "http://localhost:{server.address().port}"

home := await (await fetch(base)).text()
print(has(home, "<h1>Hi</h1>"), has(home, ".a:focus, .b:focus"), has(home, "u003c/script>"), !has(home, "</script>\"}"))
print(await (await fetch("{base}/api/user/42?q=z")).json())
print(await (await fetch("{base}/api/echo", {method: "POST", body: tojson({a: 1})})).json())
print(await (await fetch("{base}/api/echo", {method: "POST", headers: {"Content-Type": "application/x-www-form-urlencoded"}, body: "name=ada&pw=x+y"})).json())
login := await fetch("{base}/login", {method: "POST", redirect: "manual"})
print(login.status, login.headers.get("location"), login.headers.getSetCookie())
print(await (await fetch("{base}/me", {headers: {cookie: "sid=abc%20123; theme=dark"}})).json())
print((await fetch("{base}/logout")).headers.getSetCookie())
print((await fetch("{base}/old", {redirect: "manual"})).status)
t := await fetch("{base}/teapot")
print(t.status, await t.text())
print(await (await fetch("{base}/async")).text())
print(await (await fetch("{base}/files/a/b.txt")).text())
nf := await fetch("{base}/nope")
print(nf.status, has(await nf.text(), "Nicht gefunden: /nope"))
src := home.match(js.RegExp("src=\"([^\"]+)\""))[1]
js1 := await (await fetch(base + src)).text()
print(src, has(js1, "/_alien/std/html.aln"), has(js1, "/_alien/f/1/util.aln"), has(js1, "/_alien/f/2/fmt.aln"))
print((await fetch("{base}/_alien/f/2/fmt.aln")).status, (await fetch("{base}/_alien/f/9/x.aln")).status)
print(has(await (await fetch("{base}/_alien/rt.js")).text(), "export function print"))
server.close()
