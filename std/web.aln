# alien:web — websites in pure Alien: server, routes, pages, CSS and browser code.
#   use "alien:web" {serve, h, css, page, client}
#   serve({
#     "/": fn(req) page({title: "Hi", css: STYLE, body: [h.h1("Hello"), client("{here}/app.aln")]}),
#     "/api/user/:id": fn(req) {id: req.params.id},     # objects/lists -> JSON
#     "POST /api/echo": fn(req) req.body,                 # JSON bodies are parsed
#   }, {port: 8080, static: "{here}/public"})
# Handler results: string or h.* -> HTML; object/list -> JSON; reply(status, body) / redirect(url) for control.
# client(file) compiles that .aln file for the browser and returns the <script> tag that loads it.

use "node:http" as http
use "node:fs" as fs
use "node:path" as path
use "../src/compile.js" {compile}
use "alien:html" as html

pub h := html.h
pub css := html.css
pub page := html.page
pub raw := html.raw
pub esc := html.esc
pub el := html.el

HTML := "text/html; charset=utf-8"
JS := "text/javascript; charset=utf-8"
MIME := {
  ".html": HTML, ".css": "text/css; charset=utf-8", ".js": JS, ".mjs": JS,
  ".json": "application/json; charset=utf-8", ".txt": "text/plain; charset=utf-8",
  ".svg": "image/svg+xml", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
  ".gif": "image/gif", ".webp": "image/webp", ".ico": "image/x-icon", ".woff2": "font/woff2",
  ".mp4": "video/mp4", ".mp3": "audio/mpeg", ".pdf": "application/pdf",
}

# reply(status, body, opts?) -> full control over a response. opts: {type, headers, cookies}
# (old form reply(status, body, contentType, headers) still works). cookies: {name: "value" | {value, maxAge, path, httpOnly, sameSite, secure} | nil (= delete)}
pub fn reply(status, body, opts = {}, headers = {}) {
  o := if type(opts) == "str" { {type: opts, headers} } else { opts ?? {} }
  {__reply: true, status, body, ctype: o.type, headers: o.headers ?? {}, cookies: o.cookies}
}
# redirect(url, opts?) -> 303 See Other (right after a form POST, fine for GET). opts like reply: {status, cookies, headers}
pub fn redirect(to, opts = {}) reply(opts.status ?? 303, "", {headers: {...(opts.headers ?? {}), Location: to}, cookies: opts.cookies})

fn send(res, status, ctype, body, headers = {}) {
  res.writeHead(status, {"Content-Type": ctype, ...headers})
  res.end(body)
}

fn guess(x) if type(x) == "str" || html.isRaw(x) { HTML } else { MIME[".json"] }
fn bodyOf(x) if type(x) == "str" { x } else if html.isRaw(x) { x.__html } else { tojson(x) }

# Set-Cookie header lines; secure defaults: Path=/, HttpOnly, SameSite=Lax
fn cookieLines(cookies) entries(cookies ?? {}) |> map(fn([name, c]) {
  o := if c == nil { {value: "", maxAge: 0} } else if type(c) == "obj" { c } else { {value: str(c)} }
  parts := ["{name}={encodeURIComponent(o.value ?? "")}", "Path={o.path ?? "/"}"]
  if o.maxAge != nil { push(parts, "Max-Age={o.maxAge}") }
  if o.httpOnly != false { push(parts, "HttpOnly") }
  push(parts, "SameSite={o.sameSite ?? "Lax"}")
  if o.secure { push(parts, "Secure") }
  join(parts, "; ")
})

fn respond(res, out) {
  if out != nil && out.__reply == true {
    headers := {...out.headers}
    if out.cookies != nil { headers["Set-Cookie"] = cookieLines(out.cookies) }
    ret send(res, out.status, out.ctype ?? guess(out.body), bodyOf(out.body), headers)
  }
  send(res, 200, guess(out), bodyOf(out))
}

# request body: JSON and HTML forms (urlencoded) become objects, other text stays text, empty -> nil
fn readBody(req) new Promise(fn(done) {
  chunks := []
  req.on("data", fn(c) push(chunks, c))
  req.on("end", fn() {
    text := Buffer.concat(chunks).toString()
    ctype := req.headers["content-type"] ?? ""
    done(if text == "" { nil }
      else if has(ctype, "application/x-www-form-urlencoded") { Object.fromEntries(new URLSearchParams(text)) }
      else { try { json(text) } catch { text } })
  })
})

# cookies sent by the browser -> {name: value}
fn readCookies(req) split(req.headers.cookie ?? "", ";")
  |> map(trim(it))
  |> filter(has(it, "="))
  |> map(fn(c) [slice(c, 0, c.indexOf("=")), decodeURIComponent(slice(c, c.indexOf("=") + 1))])
  |> Object.fromEntries

# "/user/:id" matches "/user/7" -> {id: "7"}; a trailing "*" matches the rest: "/files/*" -> {"*": "a/b.txt"}
fn matchPath(pat, p) {
  if pat == "*" { ret {"*": slice(p, 1)} }
  a := split(pat, "/")
  b := split(p, "/")
  wild := last(a) == "*"
  if (wild && len(b) < len(a) - 1) || (!wild && len(a) != len(b)) { ret nil }
  params := {}
  for i in 0..len(a) {
    if a[i] == "*" && i == len(a) - 1 {
      params["*"] = decodeURIComponent(join(drop(b, i), "/"))
      ret params
    }
    if starts(a[i], ":") { params[slice(a[i], 1)] = decodeURIComponent(b[i]) }
    else if a[i] != b[i] { ret nil }
  }
  params
}

# first matching route; wildcard routes ("*", "/x/*") only when nothing else matched (wild = true)
fn findRoute(routes, method, p, wild = false) {
  for [key, f] in entries(routes) {
    parts := split(key, " ")
    [m, pat] := if len(parts) == 2 { parts } else { [nil, key] }
    if m != nil && m != method { continue }
    if ends(pat, "*") != wild { continue }
    params := matchPath(pat, p)
    if params != nil { ret [f, params] }
  }
  nil
}

# ---------- browser code ----------

# client(file) -> <script> tag that runs this .aln file in the browser (compiled on request)
pub fn client(file) raw("<script type=\"module\" src=\"{fileUrl(path.resolve(file))}\"></script>")

fn browserJs(file, urlPath) compile(fs.readFileSync(file, "utf8"), {
  displayFile: path.basename(file),
  runtimeUrl: "/_alien/rt.js",
  stdSpec: fn(n) "/_alien/std/{n}.aln",
  alnSpec: fn(p) fileUrl(path.resolve(path.dirname(file), p)),
  sourceUrl: urlPath,
}).code

fn serveAlien(res, p) {
  if p == "/_alien/rt.js" { ret send(res, 200, JS, fs.readFileSync(path.join(here, "../src/runtime.js"))) }
  file := match p.match(js.RegExp("^/_alien/(std|f)/([^/]+)(?:/.*)?$")) {
    [_, "std", name] => path.join(here, path.basename(name))
    [_, "f", i] => files[int(i)]
    _ => nil
  }
  if file == nil || !exists(file) { ret send(res, 404, JS, "// not found") }
  code := try { browserJs(file, p) } catch e {
    print(e.message)
    "console.error({tojson("Alien compile error in " + p + ": " + e.message)})"
  }
  send(res, 200, JS, code)
}

# ---------- server ----------

# order: /_alien/ internals, exact routes, static files, wildcard routes ("*"), 404
fn handle(routes, dir, req, res) {
  u := new URL(req.url, "http://localhost")
  p := u.pathname
  if starts(p, "/_alien/") { ret serveAlien(res, p) }
  found := findRoute(routes, req.method, p)
  if found == nil && dir != nil {
    root := path.resolve(dir)
    file := path.join(root, path.normalize(decodeURIComponent(if p == "/" { "/index.html" } else { p })))
    if starts(file, root) && exists(file) && fs.statSync(file).isFile() {
      ret send(res, 200, MIME[lower(path.extname(file))] ?? "application/octet-stream", fs.readFileSync(file))
    }
  }
  found = found ?? findRoute(routes, req.method, p, true)
  if found == nil { ret send(res, 404, HTML, "<h1>404 Not Found</h1>") }
  [f, params] := found
  body := await readBody(req)
  r := {method: req.method, path: p, params, query: Object.fromEntries(u.searchParams), headers: req.headers, cookies: readCookies(req), body, req, res}
  out := await f(r)
  if !res.writableEnded { respond(res, out) }
  nil
}

pub fn serve(routes, opts = {}) {
  port := opts.port ?? int(env("PORT")) ?? 8080
  server := http.createServer(fn(req, res) {
    handle(routes, opts.static, req, res).catch(fn(e) {
      print("error in {req.method} {req.url}: {e.stack}")
      if !res.headersSent { send(res, 500, HTML, "<h1>500 Internal Server Error</h1>") }
    })
  })
  server.listen(port, fn() {
    if !opts.quiet { print("👽 Server läuft: http://localhost:{server.address().port}") }
  })
  server
}

# browser-loadable .aln files: client entries and everything they import (nothing else is served)
files := []

fileIds := new Map()

fn fileUrl(abs) {
  if !fileIds.has(abs) {
    push(files, abs)
    fileIds.set(abs, len(files) - 1)
  }
  "/_alien/f/{fileIds.get(abs)}/{path.basename(abs)}"
}
